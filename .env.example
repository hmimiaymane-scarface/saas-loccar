# Supabase project connection.
# Find these under Project Settings -> API in your Supabase Dashboard,
# or via `supabase status` when running the local Supabase stack.
#
# Both variables below are PUBLIC (browser-visible) by Supabase design —
# access control comes from Row Level Security, not from hiding these.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key. NEVER prefix this with NEXT_PUBLIC_.
# Used only by lib/supabase/admin.ts (roadmap phase 12's operations-feed
# cron job — see that file's doc comment for why an unattended job needs
# it when every other code path uses the anon key + RLS instead).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: force mock/demo data even when the variables above are set.
# See lib/data.ts for what this controls.
# NEXT_PUBLIC_USE_MOCK_DATA=true

# AI Assistant (app/(dashboard)/ai-assistant). Either or both — the
# provider picker in the UI only offers whichever is actually configured.
# Server-side only, never prefixed with NEXT_PUBLIC_.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Authenticates requests to app/api/cron/*. Vercel sets this
# automatically and attaches it as `Authorization: Bearer $CRON_SECRET`
# to its own scheduled requests (see vercel.json) — set it yourself
# (any long random string) for local testing or a non-Vercel deployment.
CRON_SECRET=

# Push Notifications (roadmap phase 44). Generate a real key pair with
# `npx web-push generate-vapid-keys` (from the `web-push` package) --
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is browser-visible by design (it's sent
# to the push service, never secret); VAPID_PRIVATE_KEY signs outgoing
# messages and must never be exposed client-side. VAPID_SUBJECT is a
# mailto: address or https:// URL identifying who's sending push
# messages, required by the Web Push protocol so a push service can
# contact you about abuse.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Backup contact method (roadmap phase 63). Shown on /support so a
# pilot always has a real way to reach you if something breaks or the
# app itself is unreachable. Both are public by design (meant to be
# displayed, not secret) — set at least one; /support shows an honest
# "not configured yet" message if both are empty.
NEXT_PUBLIC_SUPPORT_WHATSAPP=212600000000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
